+// Tensor parallelism (--split-mode tensor): all-reduce for exactly two Vulkan devices.
+//
+// Vulkan cannot copy between two devices, so the meta backend's generic all-reduce stops both devices several times
+// per exchange: synchronize both, read one partial back to the CPU, write it to the other device, and the same the
+// other way. Measured on two Arc Pro B60s (Windows): ~190 us per exchange, two exchanges per layer.
+//
+// Here both devices import the same block of host memory (VK_EXT_external_memory_host), a ring of slots per device:
+//   1. each device copies its partial into its own slot, queued behind the subgraph that produced it
+//   2. submit both devices
+//   3. each device copies the other device's slot into a local buffer and adds it to its partial, queued; the next
+//      subgraph runs behind it
+// Three modes, chosen at init:
+//   events (default): a page of host memory holds a "written" and a "read" counter per device, which a device bumps
+//          with vkCmdFillBuffer after its copy. A relay thread reads the counters and sets a VkEvent on the other
+//          device, whose queue waits for it with vkCmdWaitEvents inside the already-running submission: no semaphore
+//          wait, so the OS scheduler never holds a submission back. "read" keeps the ring from being overwritten
+//          before it has been read. (A shader polling the counters instead would be simpler, but on the Intel
+//          Windows driver a device's polls keep returning a stale cached value for the other device's writes, with
+//          volatile, with atomics and on the uncached memory type alike; and Vulkan's external semaphores import
+//          between two physical devices but share nothing. See docs/two-card-exchange.md.)
+//   relay (GGML_VK_COMM_RELAY=1): timeline semaphores: each device signals its own, the other waits in-queue on a
+//          mirror that the relay thread host-signals. The semaphore wait costs a scheduler round trip per exchange.
+//   sync  (GGML_VK_COMM_SYNC=1, or the device serializes submissions): step 2 is one submit + wait on both devices.
+// Anything else (other device counts, non-F32, non-contiguous, no external_memory_host) gets nullptr/false and the
+// meta backend uses its generic all-reduce. GGML_VK_DISABLE_COMM=1 forces the generic path, for A/B races.
+
+struct ggml_vk_comm_context {
+    ggml_backend_t        backends[2] = {};
+    bool                  async       = false;
+    bool                  events      = false;   // async through host counters + VkEvents (else semaphores)
+    int                   n_slots     = 1;       // ring depth per device (async, set by reserve), 1 in sync mode
+    size_t                failed_bytes = 0;      // smallest tensor size whose slots could not be set up (0: none)
+    uint64_t              seq         = 0;       // exchanges so far; the counter value of the current one
+    uint8_t *             host_alloc  = nullptr; // the slots, as returned by malloc
+    uint8_t *             host_mem    = nullptr; // aligned; device j's slot k at (j*n_slots + k)*slot_size
+    size_t                slot_size   = 0;
+    vk_buffer             host_buf[2];           // host_mem as a buffer on each device
+    ggml_backend_buffer_t tmp_buf[2]  = {};      // on each device: where the other device's partial lands
+    ggml_tensor           node_tmp[2];
+    ggml_tensor           node_add[2];
+    ggml_context *        gctx        = nullptr; // holds the two one-node graphs
+    ggml_cgraph *         graph[2]    = {};
+
+    // events mode: the counter page (its own import so the ring can regrow without moving it)
+    uint8_t *             flag_alloc  = nullptr;
+    uint8_t *             flag_mem    = nullptr;
+    size_t                flag_bytes  = 0;
+    vk_buffer             flag_buf[2];
+    static constexpr int  n_events    = 256;     // ring of events per device and kind; exchanges in flight are far fewer
+    std::vector<vk::Event> ev_written[2];        // ev_written[d][s % n_events]: device d may read the other's slot of exchange s
+    std::vector<vk::Event> ev_read[2];           // ev_read[d][s % n_events]: the other device has read device d's slot of exchange s
+    uint64_t              relayed_written[2] = {}; // how far the relay has turned each device's counters into events
+    uint64_t              relayed_read[2]    = {};
+
+    // relay mode: sem_written[j][j] is signalled by device j's queue when its slot holds exchange seq; sem_written[j][1-j]
+    // is the mirror on the other device, host-signalled by the relay thread, that device 1-j's queue waits on.
+    // sem_read likewise for "device j has read the other's slot of exchange seq".
+    vk::Semaphore         sem_written[2][2];
+    vk::Semaphore         sem_read[2][2];
+    PFN_vkGetSemaphoreCounterValue pfn_counter[2] = {};
+    PFN_vkSignalSemaphore          pfn_signal[2]  = {};
+
+    std::thread           relay;
+    std::atomic<bool>     relay_stop { false };
+
+    size_t slot_offset(int j, uint64_t s) const { return (j*n_slots + (size_t) (s % n_slots)) * slot_size; }
+
+    // counters in the flag page, as uint indices (256 bytes apart so no two share a cache line)
+    static uint32_t written_idx(int j) { return j * 64; }
+    static uint32_t read_idx(int j)    { return 128 + j * 64; }
+};
+
+static void ggml_vk_comm_release_buffers(ggml_vk_comm_context * cc) {
+    for (int j = 0; j < 2; j++) {
+        ggml_vk_destroy_buffer(cc->host_buf[j]);
+        if (cc->tmp_buf[j] != nullptr) {
+            ggml_backend_buffer_free(cc->tmp_buf[j]);
+            cc->tmp_buf[j] = nullptr;
+        }
+    }
+    free(cc->host_alloc);
+    cc->host_alloc = nullptr;
+    cc->host_mem   = nullptr;
+    cc->slot_size  = 0;
+}
+
+static size_t ggml_vk_comm_import_alignment(const ggml_vk_comm_context * cc) {
+    size_t align = 1;
+    for (int j = 0; j < 2; j++) {
+        const ggml_backend_vk_context * ctx = (const ggml_backend_vk_context *) cc->backends[j]->context;
+        align = std::max(align, (size_t) ctx->device->min_imported_host_pointer_alignment);
+    }
+    return align;
+}
+
+// Grow the shared slots and the per-device landing buffers to hold nbytes. Both devices must be idle.
+// The ring is as deep as a 64 MB per-device budget allows, between 2 and 256 slots: during prompt processing a slot
+// is megabytes (then a few slots, each exchange taking long enough that the ring never stalls), during generation
+// it is kilobytes (then 256). Any depth >= 2 is correct; the "read" signals guard reuse.
+static bool ggml_vk_comm_reserve(ggml_vk_comm_context * cc, size_t nbytes) {
+    if (nbytes <= cc->slot_size) {
+        return true;
+    }
+    if (cc->failed_bytes != 0 && nbytes >= cc->failed_bytes) {
+        return false; // already failed at this size; do not retry every exchange
+    }
+    ggml_vk_comm_release_buffers(cc);
+
+    const size_t align = ggml_vk_comm_import_alignment(cc);
+    const size_t slot  = GGML_PAD(nbytes, align);
+    if (cc->async) {
+        const size_t budget = 64u * 1024 * 1024;
+        cc->n_slots = (int) std::max<size_t>(2, std::min<size_t>(ggml_vk_comm_context::n_events, budget / slot));
+    }
+
+    const size_t host_size = 2*cc->n_slots*slot;
+    cc->host_alloc = (uint8_t *) malloc(host_size + align);
+    if (cc->host_alloc == nullptr) {
+        return false;
+    }
+    cc->host_mem = (uint8_t *) GGML_PAD((uintptr_t) cc->host_alloc, align);
+
+    for (int j = 0; j < 2; j++) {
+        ggml_backend_vk_context * ctx = (ggml_backend_vk_context *) cc->backends[j]->context;
+        cc->host_buf[j] = ggml_vk_buffer_from_host_ptr(ctx->device, cc->host_mem, host_size, /*cached =*/ false);
+        cc->tmp_buf[j]  = ggml_backend_alloc_buffer(cc->backends[j], slot);
+        if (cc->host_buf[j] == nullptr || cc->tmp_buf[j] == nullptr) {
+            GGML_LOG_WARN("%s: could not set up %d x %zu-byte shared slots on device %d, using the generic all-reduce for tensors this size\n", __func__, cc->n_slots, slot, j);
+            ggml_vk_comm_release_buffers(cc);
+            cc->failed_bytes = nbytes;
+            return false;
+        }
+    }
+    cc->slot_size = slot;
+    return true;
+}
+
+// A timeline semaphore on device `owner` (signalled by its queue) and its mirror on the other device (host-signalled
+// by the relay thread, waited on by that device's queue). Both start at 0.
+static bool ggml_vk_comm_make_pair(ggml_vk_comm_context * cc, int owner, vk::Semaphore out[2]) {
+    for (int d = 0; d < 2; d++) {
+        vk::Device dev = ((ggml_backend_vk_context *) cc->backends[d]->context)->device->device;
+        vk::SemaphoreTypeCreateInfo tci{ vk::SemaphoreType::eTimeline, 0 };
+        vk::SemaphoreCreateInfo ci{};
+        ci.setPNext(&tci);
+        try {
+            out[d] = dev.createSemaphore(ci);
+        } catch (const vk::SystemError &) {
+            return false;
+        }
+    }
+    GGML_UNUSED(owner);
+    return true;
+}
+
+static void ggml_vk_comm_destroy_semaphores(ggml_vk_comm_context * cc) {
+    for (int j = 0; j < 2; j++) {
+        for (int d = 0; d < 2; d++) {
+            vk::Device dev = ((ggml_backend_vk_context *) cc->backends[d]->context)->device->device;
+            if (cc->sem_written[j][d]) {
+                dev.destroySemaphore(cc->sem_written[j][d]);
+                cc->sem_written[j][d] = nullptr;
+            }
+            if (cc->sem_read[j][d]) {
+                dev.destroySemaphore(cc->sem_read[j][d]);
+                cc->sem_read[j][d] = nullptr;
+            }
+        }
+    }
+}
+
+static void ggml_vk_comm_destroy_events(ggml_vk_comm_context * cc) {
+    for (int d = 0; d < 2; d++) {
+        vk::Device dev = ((ggml_backend_vk_context *) cc->backends[d]->context)->device->device;
+        for (vk::Event & e : cc->ev_written[d]) {
+            dev.destroyEvent(e);
+        }
+        for (vk::Event & e : cc->ev_read[d]) {
+            dev.destroyEvent(e);
+        }
+        cc->ev_written[d].clear();
+        cc->ev_read[d].clear();
+        ggml_vk_destroy_buffer(cc->flag_buf[d]);
+    }
+    free(cc->flag_alloc);
+    cc->flag_alloc = nullptr;
+    cc->flag_mem   = nullptr;
+}
+
+// events mode: the counter page and the event rings
+static bool ggml_vk_comm_setup_events(ggml_vk_comm_context * cc) {
+    const size_t align = ggml_vk_comm_import_alignment(cc);
+    cc->flag_bytes = GGML_PAD(std::max<size_t>(4096, align), align);
+    cc->flag_alloc = (uint8_t *) malloc(cc->flag_bytes + align);
+    if (cc->flag_alloc == nullptr) {
+        return false;
+    }
+    cc->flag_mem = (uint8_t *) GGML_PAD((uintptr_t) cc->flag_alloc, align);
+    memset(cc->flag_mem, 0, cc->flag_bytes);
+    for (int d = 0; d < 2; d++) {
+        ggml_backend_vk_context * ctx = (ggml_backend_vk_context *) cc->backends[d]->context;
+        cc->flag_buf[d] = ggml_vk_buffer_from_host_ptr(ctx->device, cc->flag_mem, cc->flag_bytes, /*cached =*/ false);
+        if (cc->flag_buf[d] == nullptr) {
+            return false;
+        }
+        try {
+            for (int k = 0; k < ggml_vk_comm_context::n_events; k++) {
+                cc->ev_written[d].push_back(ctx->device->device.createEvent({}));
+                cc->ev_read[d].push_back(ctx->device->device.createEvent({}));
+            }
+        } catch (const vk::SystemError &) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// The relay. events mode: when a device's "written" or "read" counter advances, set the event the other device is
+// waiting on. relay mode: host-signal the mirror semaphore. Spins on one core; a counter read is nanoseconds, a
+// semaphore counter read a few microseconds.
+static void ggml_vk_comm_relay(ggml_vk_comm_context * cc) {
+    VkDevice dev[2];
+    for (int d = 0; d < 2; d++) {
+        dev[d] = static_cast<VkDevice>(((ggml_backend_vk_context *) cc->backends[d]->context)->device->device);
+    }
+    const volatile uint32_t * flags = (const volatile uint32_t *) cc->flag_mem;
+    uint64_t sem_last[2][2] = {}; // relay mode: [written/read][owner]
+
+    int idle = 0;
+    while (!cc->relay_stop.load(std::memory_order_relaxed)) {
+        bool advanced = false;
+        for (int j = 0; j < 2; j++) {
+            if (cc->events) {
+                // device j wrote exchange s: device 1-j may read it
+                const uint32_t w = flags[ggml_vk_comm_context::written_idx(j)];
+                while ((uint32_t) cc->relayed_written[j] != w) {
+                    const uint64_t s = ++cc->relayed_written[j];
+                    vk::Device(dev[1 - j]).setEvent(cc->ev_written[1 - j][s % ggml_vk_comm_context::n_events]);
+                    advanced = true;
+                }
+                // device j read exchange s of the other's slot: device 1-j may overwrite that slot
+                const uint32_t r = flags[ggml_vk_comm_context::read_idx(j)];
+                while ((uint32_t) cc->relayed_read[j] != r) {
+                    const uint64_t s = ++cc->relayed_read[j];
+                    vk::Device(dev[1 - j]).setEvent(cc->ev_read[1 - j][s % ggml_vk_comm_context::n_events]);
+                    advanced = true;
+                }
+            } else {
+                const vk::Semaphore src[2]    = { cc->sem_written[j][j],     cc->sem_read[j][j]     };
+                const vk::Semaphore mirror[2] = { cc->sem_written[j][1 - j], cc->sem_read[j][1 - j] };
+                for (int k = 0; k < 2; k++) {
+                    uint64_t v = 0;
+                    if (cc->pfn_counter[j](dev[j], src[k], &v) == VK_SUCCESS && v > sem_last[k][j]) {
+                        VkSemaphoreSignalInfo si = { VK_STRUCTURE_TYPE_SEMAPHORE_SIGNAL_INFO, nullptr, mirror[k], v };
+                        cc->pfn_signal[1 - j](dev[1 - j], &si);
+                        sem_last[k][j] = v;
+                        advanced = true;
+                    }
+                }
+            }
+        }
+        if (advanced) {
+            idle = 0;
+        } else if (++idle > 2000) {
+            std::this_thread::yield(); // nothing moving (between tokens, or the model is loading): give the core up
+        }
+    }
+}
+
+// events mode: bump the counter at byte offset `off` of the flag page to value, after everything this queue has
+// copied so far, and make it visible outside the device.
+static void ggml_vk_comm_set_flag(ggml_vk_comm_context * cc, vk_context & subctx, int dev, size_t off, uint64_t value) {
+    // memory barriers as braced pairs: windows.h defines MemoryBarrier as a macro, so vk::MemoryBarrier cannot be named
+    vk::CommandBuffer & cb = subctx->s->buffer->buf;
+    cb.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, vk::PipelineStageFlagBits::eTransfer, {},
+                       { { { vk::AccessFlagBits::eTransferWrite }, { vk::AccessFlagBits::eTransferWrite } } }, {}, {});
+    cb.fillBuffer(cc->flag_buf[dev]->buffer, off, 4, (uint32_t) value);
+    cb.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, vk::PipelineStageFlagBits::eTransfer | vk::PipelineStageFlagBits::eHost, {},
+                       { { { vk::AccessFlagBits::eTransferWrite }, { vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite | vk::AccessFlagBits::eHostRead } } }, {}, {});
+}
+
+// events mode: queue a wait for a host-set event, then reset it for its next use (the ring is 256 deep, so the
+// reset has long executed before the relay sets the event again).
+static void ggml_vk_comm_wait_event(vk_context & subctx, vk::Event event) {
+    vk::CommandBuffer & cb = subctx->s->buffer->buf;
+    cb.waitEvents({ event }, vk::PipelineStageFlagBits::eHost, vk::PipelineStageFlagBits::eAllCommands,
+                  { { { vk::AccessFlagBits::eHostWrite }, { vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite | vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite } } }, {}, {});
+    cb.resetEvent(event, vk::PipelineStageFlagBits::eAllCommands);
+}
+
+static void * ggml_backend_vk_comm_init(ggml_backend_t * backends, size_t n_backends) {
+    if (n_backends != 2 || getenv("GGML_VK_DISABLE_COMM") != nullptr) {
+        return nullptr;
+    }
+    bool can_async   = getenv("GGML_VK_COMM_SYNC") == nullptr;
+    const bool relay = getenv("GGML_VK_COMM_RELAY") != nullptr;
+    for (size_t j = 0; j < n_backends; j++) {
+        if (!ggml_backend_is_vk(backends[j])) {
+            return nullptr;
+        }
+        const ggml_backend_vk_context * ctx = (const ggml_backend_vk_context *) backends[j]->context;
+        if (!ctx->device->external_memory_host) {
+            return nullptr;
+        }
+        if (ctx->device->serialize_submissions) {
+            can_async = false;
+        }
+    }
+
+    ggml_vk_comm_context * cc = new ggml_vk_comm_context;
+    cc->backends[0] = backends[0];
+    cc->backends[1] = backends[1];
+
+    if (can_async && !relay) {
+        cc->async  = true;
+        cc->events = ggml_vk_comm_setup_events(cc);
+        if (!cc->events) {
+            GGML_LOG_WARN("%s: could not set up the counter page or the events; all-reduce will stop the CPU once per exchange\n", __func__);
+            ggml_vk_comm_destroy_events(cc);
+            cc->async = false;
+        }
+    } else if (can_async) {
+        cc->async = true;
+        for (int d = 0; d < 2 && cc->async; d++) {
+            VkDevice dev = static_cast<VkDevice>(((ggml_backend_vk_context *) backends[d]->context)->device->device);
+            cc->pfn_counter[d] = (PFN_vkGetSemaphoreCounterValue) vkGetDeviceProcAddr(dev, "vkGetSemaphoreCounterValue");
+            cc->pfn_signal[d]  = (PFN_vkSignalSemaphore)          vkGetDeviceProcAddr(dev, "vkSignalSemaphore");
+            if (cc->pfn_counter[d] == nullptr) {
+                cc->pfn_counter[d] = (PFN_vkGetSemaphoreCounterValue) vkGetDeviceProcAddr(dev, "vkGetSemaphoreCounterValueKHR");
+            }
+            if (cc->pfn_signal[d] == nullptr) {
+                cc->pfn_signal[d] = (PFN_vkSignalSemaphore) vkGetDeviceProcAddr(dev, "vkSignalSemaphoreKHR");
+            }
+            cc->async = cc->pfn_counter[d] != nullptr && cc->pfn_signal[d] != nullptr;
+        }
+        for (int j = 0; j < 2 && cc->async; j++) {
+            cc->async = ggml_vk_comm_make_pair(cc, j, cc->sem_written[j]) && ggml_vk_comm_make_pair(cc, j, cc->sem_read[j]);
+        }
+        if (!cc->async) {
+            GGML_LOG_WARN("%s: no timeline semaphore host signalling; all-reduce will stop the CPU once per exchange\n", __func__);
+            ggml_vk_comm_destroy_semaphores(cc);
+        }
+    }
+    if (cc->async) {
+        cc->relay = std::thread(ggml_vk_comm_relay, cc);
+    }
+    cc->n_slots = cc->async ? ggml_vk_comm_context::n_events : 1;
+
+    const ggml_init_params params = { 2*ggml_graph_overhead_custom(1, false), nullptr, /*no_alloc =*/ true };
+    cc->gctx = ggml_init(params);
+    for (int j = 0; j < 2; j++) {
+        cc->graph[j] = ggml_new_graph_custom(cc->gctx, 1, false);
+    }
+    return cc;
+}
+
+static void ggml_backend_vk_comm_free(void * comm_ctx) {
+    ggml_vk_comm_context * cc = (ggml_vk_comm_context *) comm_ctx;
+    if (cc == nullptr) {
+        return;
+    }
+    for (int j = 0; j < 2; j++) {
+        ggml_backend_synchronize(cc->backends[j]); // needs the relay alive: queued waits are satisfied through it
+    }
+    if (cc->relay.joinable()) {
+        cc->relay_stop.store(true);
+        cc->relay.join();
+    }
+    ggml_vk_comm_release_buffers(cc);
+    ggml_vk_comm_destroy_semaphores(cc);
+    ggml_vk_comm_destroy_events(cc);
+    ggml_free(cc->gctx);
+    delete cc;
+}
+
+static bool ggml_backend_vk_comm_allreduce_tensor(void * comm_ctx, ggml_tensor ** tensors) {
+    ggml_vk_comm_context * cc = (ggml_vk_comm_context *) comm_ctx;
+    ggml_tensor * t[2] = { tensors[0], tensors[1] };
+
+    for (int j = 0; j < 2; j++) {
+        if (t[j]->type != GGML_TYPE_F32 || !ggml_is_contiguous(t[j]) || !ggml_backend_buffer_is_vk(t[j]->buffer)) {
+            return false;
+        }
+        if ((t[j]->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return false; // a disabled zero-size slice: the generic path zeroes it first
+        }
+    }
+    if (ggml_nelements(t[0]) != ggml_nelements(t[1])) {
+        return false;
+    }
+    const size_t nbytes = ggml_nbytes(t[0]);
+    if (nbytes == 0) {
+        return true;
+    }
+
+    ggml_backend_vk_context * ctx[2] = {
+        (ggml_backend_vk_context *) cc->backends[0]->context,
+        (ggml_backend_vk_context *) cc->backends[1]->context,
+    };
+
+    if (nbytes > cc->slot_size) {
+        for (int j = 0; j < 2; j++) {
+            ggml_backend_synchronize(cc->backends[j]); // the old landing buffers may still be in use
+        }
+        if (!ggml_vk_comm_reserve(cc, nbytes)) {
+            return false;
+        }
+    }
+
+    const uint64_t seq = ++cc->seq;
+    const int n_ev = ggml_vk_comm_context::n_events;
+
+    // 1. each device: its partial -> its slot, queued behind the subgraph that wrote it. async: this submission
+    //    announces "written" = seq, and (once the ring has wrapped) first waits for the other device to have read
+    //    what was in this slot last time round
+    for (int j = 0; j < 2; j++) {
+        vk_context subctx = ggml_vk_get_compute_ctx(ctx[j]);
+        if (cc->async && seq > (uint64_t) cc->n_slots) {
+            if (cc->events) {
+                ggml_vk_comm_wait_event(subctx, cc->ev_read[j][(seq - cc->n_slots) % n_ev]);
+            } else {
+                subctx->s->wait_semaphores.push_back({ cc->sem_read[1 - j][j], seq - cc->n_slots });
+            }
+        }
+        ggml_vk_sync_buffers(ctx[j], subctx);
+        vk_buffer src = ((ggml_backend_vk_buffer_context *) t[j]->buffer->context)->dev_buffer;
+        ggml_vk_buffer_copy_async(subctx, cc->host_buf[j], cc->slot_offset(j, seq), src, vk_tensor_offset(t[j]) + t[j]->view_offs, nbytes);
+        if (cc->async) {
+            if (cc->events) {
+                ggml_vk_comm_set_flag(cc, subctx, j, 4 * ggml_vk_comm_context::written_idx(j), seq);
+            } else {
+                subctx->s->signal_semaphores.push_back({ cc->sem_written[j][j], seq });
+            }
+        }
+    }
+
+    // 2. submit both devices. sync: then wait for both (the one stop). async: no wait
+    if (cc->async) {
+        for (int j = 0; j < 2; j++) {
+            if (ggml_vk_submit_transfer_ctx(ctx[j])) {
+                ctx[j]->submit_pending = true;
+            }
+            vk_context subctx = ctx[j]->compute_ctx.lock();
+            ggml_vk_ctx_end(subctx);
+            for (auto & cpy : subctx->in_memcpys) {
+                memcpy(cpy.dst, cpy.src, cpy.n);
+            }
+            GGML_ASSERT(subctx->out_memcpys.empty()); // host reads are only queued around a synchronize
+            ggml_vk_submit(subctx, {});
+            ctx[j]->submit_pending = true;
+            ctx[j]->compute_ctx.reset();
+        }
+    } else {
+        vk_sync_ticket ticket[2];
+        for (int j = 0; j < 2; j++) {
+            ticket[j] = ggml_vk_synchronize_submit(ctx[j]);
+        }
+        for (int j = 0; j < 2; j++) {
+            ggml_vk_synchronize_wait(ctx[j], ticket[j]);
+            ggml_vk_graph_cleanup(ctx[j]);
+        }
+    }
+
+    // 3. each device: the other's slot -> local buffer, then partial += it; queued. async: this submission first
+    //    waits (in-queue) for the other device's "written" = seq, and announces "read" = seq when the copy is done
+    for (int j = 0; j < 2; j++) {
+        vk_context subctx = ggml_vk_get_compute_ctx(ctx[j]);
+        if (cc->async) {
+            if (cc->events) {
+                ggml_vk_comm_wait_event(subctx, cc->ev_written[j][seq % n_ev]);
+            } else {
+                subctx->s->wait_semaphores.push_back({ cc->sem_written[1 - j][j], seq });
+                subctx->s->signal_semaphores.push_back({ cc->sem_read[j][j], seq });
+            }
+        }
+        vk_buffer tmp = ((ggml_backend_vk_buffer_context *) cc->tmp_buf[j]->context)->dev_buffer;
+        ggml_vk_buffer_copy_async(subctx, tmp, 0, cc->host_buf[j], cc->slot_offset(1 - j, seq), nbytes);
+        ggml_vk_sync_buffers(ctx[j], subctx);
+        if (cc->events) {
+            ggml_vk_comm_set_flag(cc, subctx, j, 4 * ggml_vk_comm_context::read_idx(j), seq);
+        }
+
+        ggml_tensor * node_tmp = &cc->node_tmp[j];
+        memset(node_tmp, 0, sizeof(ggml_tensor));
+        node_tmp->type = GGML_TYPE_F32;
+        for (int k = 0; k < GGML_MAX_DIMS; k++) {
+            node_tmp->ne[k] = t[j]->ne[k];
+            node_tmp->nb[k] = t[j]->nb[k];
+        }
+        node_tmp->buffer = cc->tmp_buf[j];
+        node_tmp->data   = ggml_backend_buffer_get_base(cc->tmp_buf[j]);
+
+        ggml_tensor * node_add = &cc->node_add[j];
+        memset(node_add, 0, sizeof(ggml_tensor));
+        node_add->type = GGML_TYPE_F32;
+        for (int k = 0; k < GGML_MAX_DIMS; k++) {
+            node_add->ne[k] = t[j]->ne[k];
+            node_add->nb[k] = t[j]->nb[k];
+        }
+        node_add->op        = GGML_OP_ADD;
+        node_add->src[0]    = t[j];
+        node_add->src[1]    = node_tmp;
+        node_add->view_src  = t[j]->view_src != nullptr ? t[j]->view_src : t[j];
+        node_add->view_offs = t[j]->view_offs;
+        node_add->flags    |= GGML_TENSOR_FLAG_COMPUTE;
+        ggml_backend_view_init(node_add);
+
+        cc->graph[j]->nodes[0] = node_add;
+        cc->graph[j]->n_nodes  = 1;
+        if (ggml_backend_graph_compute_async(cc->backends[j], cc->graph[j]) != GGML_STATUS_SUCCESS) {
+            GGML_ABORT("%s: add on device %d failed", __func__, j); // half done: falling back would add twice
+        }
+    }
+    return true;
+}
+
+static void * ggml_backend_vk_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
+    GGML_UNUSED(reg);
+    if (strcmp(name, "ggml_backend_comm_init") == 0) {
+        return (void *) ggml_backend_vk_comm_init;
+    }
+    if (strcmp(name, "ggml_backend_comm_free") == 0) {
+        return (void *) ggml_backend_vk_comm_free;
+    }
+    if (strcmp(name, "ggml_backend_comm_allreduce_tensor") == 0) {
+        return (void *) ggml_backend_vk_comm_allreduce_tensor;
+    }
+    return nullptr;
+}
