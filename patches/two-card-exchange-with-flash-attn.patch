+static void * ggml_backend_vk_comm_init(ggml_backend_t * backends, size_t n_backends) {
+    if (n_backends != 2 || getenv("GGML_VK_DISABLE_COMM") != nullptr) {
+        return nullptr;
+    }
+    bool can_async   = getenv("GGML_VK_COMM_SYNC") == nullptr;
+    const bool relay = getenv("GGML_VK_COMM_RELAY") != nullptr;
+    for (size_t j = 0; j < n_backends; j++) {
+        if (!ggml_backend_is_vk(backends[j])) {
+            return nullptr;
+        }
+        const ggml_backend_vk_context * ctx = (const ggml_backend_vk_context *) backends[j]->context;
+        if (!ctx->device->external_memory_host) {
+            return nullptr;
+        }
+        if (ctx->device->serialize_submissions) {
+            can_async = false;
+        }
+    }
+
+    ggml_vk_comm_context * cc = new ggml_vk_comm_context;
+    cc->backends[0] = backends[0];
+    cc->backends[1] = backends[1];
+
+    if (can_async && !relay) {
+        cc->async  = true;
+        cc->events = ggml_vk_comm_setup_events(cc);
+        if (!cc->events) {
+            GGML_LOG_WARN("%s: could not set up the counter page or the events; all-reduce will stop the CPU once per exchange\n", __func__);
+            ggml_vk_comm_destroy_events(cc);
+            cc->async = false;
+        }
+    } else if (can_async) {
+        cc->async = true;
+        for (int d = 0; d < 2 && cc->async; d++) {
+            VkDevice dev = static_cast<VkDevice>(((ggml_backend_vk_context *) backends[d]->context)->device->device);
+            cc->pfn_counter[d] = (PFN_vkGetSemaphoreCounterValue) vkGetDeviceProcAddr(dev, "vkGetSemaphoreCounterValue");
+            cc->pfn_signal[d]  = (PFN_vkSignalSemaphore)          vkGetDeviceProcAddr(dev, "vkSignalSemaphore");
+            if (cc->pfn_counter[d] == nullptr) {
+                cc->pfn_counter[d] = (PFN_vkGetSemaphoreCounterValue) vkGetDeviceProcAddr(dev, "vkGetSemaphoreCounterValueKHR");
+            }
+            if (cc->pfn_signal[d] == nullptr) {
+                cc->pfn_signal[d] = (PFN_vkSignalSemaphore) vkGetDeviceProcAddr(dev, "vkSignalSemaphoreKHR");
+            }
+            cc->async = cc->pfn_counter[d] != nullptr && cc->pfn_signal[d] != nullptr;
+        }
+        for (int j = 0; j < 2 && cc->async; j++) {
+            cc->async = ggml_vk_comm_make_pair(cc, j, cc->sem_written[j]) && ggml_vk_comm_make_pair(cc, j, cc->sem_read[j]);
+        }
+        if (!cc->async) {
+            GGML_LOG_WARN("%s: no timeline semaphore host signalling; all-reduce will stop the CPU once per exchange\n", __func__);
+            ggml_vk_comm_destroy_semaphores(cc);
+        }
+    }
+    if (cc->async) {
+        cc->relay = std::thread(ggml_vk_comm_relay, cc);
+    }
+    cc->n_slots = cc->async ? ggml_vk_comm_context::n_events : 1;
+
+    const ggml_init_params params = { 2*ggml_graph_overhead_custom(1, false), nullptr, /*no_alloc =*/ true };
+    cc->gctx = ggml_init(params);
+    for (int j = 0; j < 2; j++) {
+        cc->graph[j] = ggml_new_graph_custom(cc->gctx, 1, false);
+    }
+    return cc;
+}
+
+static void ggml_backend_vk_comm_free(void * comm_ctx) {
+    ggml_vk_comm_context * cc = (ggml_vk_comm_context *) comm_ctx;
+    if (cc == nullptr) {
+        return;
+    }
+    for (int j = 0; j < 2; j++) {
+        ggml_backend_synchronize(cc->backends[j]); // needs the relay alive: queued waits are satisfied through it
+    }
+    if (cc->relay.joinable()) {
+        cc->relay_stop.store(true);
+        cc->relay.join();
+    }
+    ggml_vk_comm_release_buffers(cc);
+    ggml_vk_comm_destroy_semaphores(cc);
+    ggml_vk_comm_destroy_events(cc);
+    ggml_free(cc->gctx);
+    delete cc;
+}
+
+static bool ggml_backend_vk_comm_allreduce_tensor(void * comm_ctx, ggml_tensor ** tensors) {
+    ggml_vk_comm_context * cc = (ggml_vk_comm_context *) comm_ctx;
+    ggml_tensor * t[2] = { tensors[0], tensors[1] };
+
+    for (int j = 0; j < 2; j++) {
+        if (t[j]->type != GGML_TYPE_F32 || !ggml_is_contiguous(t[j]) || !ggml_backend_buffer_is_vk(t[j]->buffer)) {
+            return false;
+        }
+        if ((t[j]->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return false; // a disabled zero-size slice: the generic path zeroes it first
+        }
+    }
+    if (ggml_nelements(t[0]) != ggml_nelements(t[1])) {
+        return false;
+    }
+    const size_t nbytes = ggml_nbytes(t[0]);
+    if (nbytes == 0) {
+        return true;
+    }
+
+    ggml_backend_vk_context * ctx[2] = {
+        (ggml_backend_vk_context *) cc->backends[0]->context,
+        (ggml_backend_vk_context *) cc->backends[1]->context,
+    };
+
+    if (nbytes > cc->slot_size) {
+        for (int j = 0; j < 2; j++) {
+            ggml_backend_synchronize(cc->backends[j]); // the old landing buffers may still be in use
+        }
+        if (!ggml_vk_comm_reserve(cc, nbytes)) {
+            return false;
+        }
+    }
+
+    const uint64_t seq = ++cc->seq;
+    const int n_ev = ggml_vk_comm_context::n_events;
+
+    // 1. each device: its partial -> its slot, queued behind the subgraph that wrote it. async: this submission
+    //    announces "written" = seq, and (once the ring has wrapped) first waits for the other device to have read
+    //    what was in this slot last time round
+    for (int j = 0; j < 2; j++) {
+        vk_context subctx = ggml_vk_get_compute_ctx(ctx[j]);
+        if (cc->async && seq > (uint64_t) cc->n_slots) {
+            if (cc->events) {
+                ggml_vk_comm_wait_event(subctx, cc->ev_read[j][(seq - cc->n_slots) % n_ev]);
+            } else {
+                subctx->s->wait_semaphores.push_back({ cc->sem_read[1 - j][j], seq - cc->n_slots });
+            }
+        }
