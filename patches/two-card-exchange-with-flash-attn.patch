+// events mode: bump the counter at byte offset `off` of the flag page to value, after everything this queue has
+// copied so far, and make it visible outside the device.
+static void ggml_vk_comm_set_flag(ggml_vk_comm_context * cc, vk_context & subctx, int dev, size_t off, uint64_t value) {
+    // memory barriers as braced pairs: windows.h defines MemoryBarrier as a macro, so vk::MemoryBarrier cannot be named
+    vk::CommandBuffer & cb = subctx->s->buffer->buf;
+    cb.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, vk::PipelineStageFlagBits::eTransfer, {},
+                       { { { vk::AccessFlagBits::eTransferWrite }, { vk::AccessFlagBits::eTransferWrite } } }, {}, {});
+    cb.fillBuffer(cc->flag_buf[dev]->buffer, off, 4, (uint32_t) value);
+    cb.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, vk::PipelineStageFlagBits::eTransfer | vk::PipelineStageFlagBits::eHost, {},
+                       { { { vk::AccessFlagBits::eTransferWrite }, { vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite | vk::AccessFlagBits::eHostRead } } }, {}, {});
+}
+
+// events mode: queue a wait for a host-set event, then reset it for its next use (the ring is 256 deep, so the
+// reset has long executed before the relay sets the event again).
+static void ggml_vk_comm_wait_event(vk_context & subctx, vk::Event event) {
+    vk::CommandBuffer & cb = subctx->s->buffer->buf;
+    cb.waitEvents({ event }, vk::PipelineStageFlagBits::eHost, vk::PipelineStageFlagBits::eAllCommands,
+                  { { { vk::AccessFlagBits::eHostWrite }, { vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite | vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite } } }, {}, {});
+    cb.resetEvent(event, vk::PipelineStageFlagBits::eAllCommands);
+}
